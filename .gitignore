paper/final/*.pdf
paper/pilot/*.pdf
paper/proposal/*.pdf

# Local Claude Code settings (the shared rules, agents and skills are kept)
.claude/settings.local.json

# Joined run tables written by the result targets (make results)
data/*.csv

# OS / editor
.DS_Store
.vscode/
.idea/
.junie/

# Python
__pycache__/
.mypy_cache/

# Pinned browser builds (downloaded by harness/browsers.py)
harness/browsers/

# Mac smoke runs and quick checks (never results)
data/mac-smoke/
data/raw/quick-*/

